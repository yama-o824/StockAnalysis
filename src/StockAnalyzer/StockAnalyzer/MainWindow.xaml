<Window x:Class="StockAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StockAnalyzer"
        mc:Ignorable="d"
        Title="Stock Analyzer" Height="560" Width="980">
    <Window.Resources>
        <Style x:Key="NumericCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="銘柄" Width="48" VerticalAlignment="Center"/>
                <ComboBox x:Name="SymbolComboBox"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          Width="180"
                          Height="24"/>
                <Label Content="期間" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="PeriodComboBox"
                          DisplayMemberPath="Label"
                          Width="90"
                          Height="24"/>
                <Button x:Name="FetchButton" Content="取得" Click="FetchButton_Click" Width="64" Height="24" Margin="10,0,0,0"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <ProgressBar x:Name="LoadingBar"
                     Width="120"
                     Height="14"
                     Margin="12,0,0,0"
                     IsIndeterminate="True"
                     Visibility="Collapsed"/>
            </StackPanel>
            <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                <Label Content="対象シグナル" VerticalAlignment="Center"/>
                <ComboBox x:Name="SignalTypeComboBox"
                          DisplayMemberPath="Label"
                          Width="100"
                          Height="24"/>
                <Label Content="最小スコア" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="ScoreFilterComboBox"
                          DisplayMemberPath="Label"
                          Width="90"
                          Height="24"/>
                <Label Content="エントリーまでの営業日数" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="EntryDelayTextBox"
                         Width="48"
                         Height="24"
                         Text="1"/>
                <Label Content="保有営業日数" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="HoldingBarsTextBox"
                         Width="48"
                         Height="24"
                         Text="5"/>
                <Button x:Name="RefreshBacktestButton" Content="バックテスト更新" Click="RefreshBacktestButton_Click" Width="116" Height="24" Margin="12,0,0,0"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="バックテスト結果" Margin="0,16,0,4" FontWeight="Bold"/>
                <TextBlock x:Name="BacktestPlaceholderText"
                           Margin="0,0,0,8"
                           Foreground="#586069"
                           Text="価格データを取得すると、バックテスト結果を表示します。"/>
                <Border x:Name="BacktestSummaryPanel"
                        Margin="0,0,0,8"
                        Padding="12"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                            <TextBlock Text="対象シグナル数" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SignalCount, StringFormat=N0}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                            <TextBlock Text="取引数" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TradeCount, StringFormat=N0}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,8">
                            <TextBlock Text="不足データ" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SkippedSignalCount, StringFormat=N0}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,8">
                            <TextBlock Text="勝率" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding WinRate, StringFormat=P2}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                            <TextBlock Text="平均損益率" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AverageProfitLossRate, StringFormat=P2}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,8">
                            <TextBlock Text="勝ち取引の平均" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AverageWinRate, StringFormat=P2}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                            <TextBlock Text="負け取引の平均" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AverageLossRate, StringFormat=P2}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataGrid x:Name="BacktestDataGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="シグナル日"
                                            Binding="{Binding SignalDate}"
                                            Width="100"/>
                        <DataGridTextColumn Header="種別"
                                            Binding="{Binding SignalType}"
                                            ElementStyle="{StaticResource CenterCellStyle}"
                                            Width="70"/>
                        <DataGridTextColumn Header="スコア"
                                            Binding="{Binding Score}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="70"/>
                        <DataGridTextColumn Header="ランク"
                                            Binding="{Binding Rank}"
                                            ElementStyle="{StaticResource CenterCellStyle}"
                                            Width="70"/>
                        <DataGridTextColumn Header="エントリー日"
                                            Binding="{Binding EntryDate}"
                                            Width="100"/>
                        <DataGridTextColumn Header="エントリー価格"
                                            Binding="{Binding EntryPrice, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="110"/>
                        <DataGridTextColumn Header="決済日"
                                            Binding="{Binding ExitDate}"
                                            Width="100"/>
                        <DataGridTextColumn Header="決済価格"
                                            Binding="{Binding ExitPrice, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="100"/>
                        <DataGridTextColumn Header="損益"
                                            Binding="{Binding ProfitLoss, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="90"/>
                        <DataGridTextColumn Header="損益率"
                                            Binding="{Binding ProfitLossRate, StringFormat=P2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="90"/>
                        <DataGridTextColumn Header="スコア内訳"
                                            Binding="{Binding ScoreBreakdown}"
                                            Width="220"/>
                        <DataGridTextColumn Header="根拠"
                                            Binding="{Binding Reasons}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="シグナル一覧" Margin="0,16,0,4" FontWeight="Bold"/>
                <DataGrid x:Name="SignalsDataGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日付"
                                            Binding="{Binding Date}"
                                            Width="100"/>
                        <DataGridTextColumn Header="種別"
                                            Binding="{Binding Type}"
                                            ElementStyle="{StaticResource CenterCellStyle}"
                                            Width="70"/>
                        <DataGridTextColumn Header="前日終値"
                                            Binding="{Binding PrevPrice, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="90"/>
                        <DataGridTextColumn Header="前日MA75"
                                            Binding="{Binding PrevMa, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="90"/>
                        <DataGridTextColumn Header="前日乖離"
                                            Binding="{Binding PrevDiff, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="90"/>
                        <DataGridTextColumn Header="当日終値"
                                            Binding="{Binding Price, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="90"/>
                        <DataGridTextColumn Header="当日MA75"
                                            Binding="{Binding Ma, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="90"/>
                        <DataGridTextColumn Header="当日乖離"
                                            Binding="{Binding CurrentDiff, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="90"/>
                        <DataGridTextColumn Header="20日平均出来高"
                                            Binding="{Binding Avg20Volume, StringFormat=N0}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="130"/>
                        <DataGridTextColumn Header="出来高倍率"
                                            Binding="{Binding VolumeRatio, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="100"/>
                        <DataGridTextColumn Header="MA75乖離率"
                                            Binding="{Binding Ma75DeviationRate, StringFormat=P2}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="100"/>
                        <DataGridTextColumn Header="スコア"
                                            Binding="{Binding Score}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            Width="70"/>
                        <DataGridTextColumn Header="ランク"
                                            Binding="{Binding Rank}"
                                            ElementStyle="{StaticResource CenterCellStyle}"
                                            Width="70"/>
                        <DataGridTextColumn Header="スコア内訳"
                                            Binding="{Binding ScoreBreakdown}"
                                            Width="220"/>
                        <DataGridCheckBoxColumn Header="出来高支持"
                                                Binding="{Binding HasVolumeSupport}"
                                                Width="90"/>
                        <DataGridCheckBoxColumn Header="押し目反発"
                                                Binding="{Binding IsPullbackBounce}"
                                                Width="90"/>
                        <DataGridCheckBoxColumn Header="強い陽線"
                                                Binding="{Binding HasStrongBullishCandle}"
                                                Width="80"/>
                        <DataGridTextColumn Header="根拠"
                                            Binding="{Binding Reasons}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Expander Header="価格データ一覧"
                          Margin="0,16,0,0"
                          IsExpanded="False">
                    <DataGrid Name="PricesDataGrid"
                              Margin="0,10,0,0"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日付"
                                                Binding="{Binding Date}"
                                                Width="100"/>
                            <DataGridTextColumn Header="始値"
                                                Binding="{Binding Open, StringFormat=N2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="90"/>
                            <DataGridTextColumn Header="高値"
                                                Binding="{Binding High, StringFormat=N2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="90"/>
                            <DataGridTextColumn Header="安値"
                                                Binding="{Binding Low, StringFormat=N2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="90"/>
                            <DataGridTextColumn Header="終値"
                                                Binding="{Binding Close, StringFormat=N2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="90"/>
                            <DataGridTextColumn Header="出来高"
                                                Binding="{Binding Volume, StringFormat=N0}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="110"/>
                            <DataGridTextColumn Header="MA75"
                                                Binding="{Binding MA75, StringFormat=N2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="100"/>
                            <DataGridTextColumn Header="20日平均出来高"
                                                Binding="{Binding Avg20Volume, StringFormat=N0}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="130"/>
                            <DataGridTextColumn Header="出来高倍率"
                                                Binding="{Binding VolumeRatio, StringFormat=N2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="100"/>
                            <DataGridTextColumn Header="実体率"
                                                Binding="{Binding BodyRate, StringFormat=P2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="90"/>
                            <DataGridTextColumn Header="上ヒゲ率"
                                                Binding="{Binding UpperShadowRate, StringFormat=P2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="90"/>
                            <DataGridTextColumn Header="終値位置"
                                                Binding="{Binding ClosePositionRate, StringFormat=P2}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
